# FlowBoard stack configuration.
#
#   cp deploy/.env.example deploy/.env   then edit it.
#
# Compose reads this file automatically when it sits next to docker-compose.yml.

# REQUIRED. Signs every access token; rotating it invalidates all sessions.
# Generate one with:  openssl rand -hex 32
FLOWBOARD_JWT_SECRET=change-me-openssl-rand-hex-32

# Host port that nginx is published on. Put your TLS terminator in front.
FLOWBOARD_HTTP_PORT=8080

# Comma-separated browser origins allowed to call the API directly. When the SPA
# is served by this same nginx, a single origin (this URL) is enough.
FLOWBOARD_ALLOWED_ORIGINS=http://localhost:8080

# Seed the demo account (demo@flowboard.app / demo1234) on an empty database.
# Turn this off for anything real.
FLOWBOARD_SEED_DEMO=true

# Log verbosity: debug | info | warn | error
FLOWBOARD_LOG_LEVEL=info

# Session lifetimes.
FLOWBOARD_ACCESS_TTL=30m
FLOWBOARD_REFRESH_TTL=720h

# Image tags and build metadata (also injected into the binary via -ldflags).
FLOWBOARD_VERSION=1.0.0
FLOWBOARD_COMMIT=local
FLOWBOARD_BUILD_TIME=unknown
