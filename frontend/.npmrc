# pnpm settings for FlowBoard.
#
# minimum-release-age (minutes): pnpm refuses lockfile entries published more
# recently than this during `--frozen-lockfile` installs. 1440 = 24 hours, which
# is pnpm's own default for this guard; it is written out explicitly so local
# development and CI behave identically rather than depending on a tool default.
#
# Two transitive markdown packages are pinned in package.json > pnpm.overrides
# because freshly published releases tripped this check.
minimum-release-age=1440
